;;; -*- clojure -*-
{:paths ["src" "resources"]
 :deps {aero/aero {:mvn/version "1.1.6"}
        juxt/clip {:mvn/version "0.29.0"}
        com.cognitect/anomalies {:mvn/version "0.1.12"}
        ;; logging
        org.clojure/tools.logging {:mvn/version "1.3.0"}}
 :aliases
 {:dev
  {:extra-paths ["dev"]
   :extra-deps {org.clojure/clojure {:mvn/version "1.12.3"}
                org.apache.logging.log4j/log4j-api {:mvn/version "2.25.2"}
                org.apache.logging.log4j/log4j-1.2-api {:mvn/version "2.25.2"}
                org.apache.logging.log4j/log4j-jcl {:mvn/version "2.25.2"}
                org.apache.logging.log4j/log4j-jul {:mvn/version "2.25.2"}
                org.apache.logging.log4j/log4j-slf4j-impl {:mvn/version "2.25.2"}
                org.apache.logging.log4j/log4j-slf4j2-impl {:mvn/version "2.25.2"}}
   :jvm-opts ["-Djdk.attach.allowAttachSelf"
              "-XX:-OmitStackTraceInFastThrow"
              "-Dclojure.tools.logging.factory=clojure.tools.logging.impl/log4j2-factory"]}
  :run-m
  {:main-opts ["-m" "{{top/ns}}.{{main/ns}}"]
   :jvm-opts ["-Dclojure.tools.logging.factory=clojure.tools.logging.impl/log4j2-factory"
              "-Dlog4j2.shutdownHookEnabled=false"]}
  :prof
  {:extra-deps {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.6.2"}}
   :jvm-opts ["-Djdk.attach.allowAttachSelf"
              "-XX:+UnlockDiagnosticVMOptions"
              "-XX:+DebugNonSafepoints"]}
  :test
  {:extra-paths ["test"]
   :extra-deps {io.github.noahtheduke/lazytest {:mvn/version "1.9.1"}
                org.clojure/test.check {:mvn/version "1.1.1"}
                com.gfredericks/test.chuck {:mvn/version "0.2.15"}}
   :main-opts ["-m" "lazytest.main"]}
  :build
  {:deps {io.github.clojure/tools.build
          {:git/tag "v0.10.11" :git/sha "c6c670a"}
          slipset/deps-deploy {:mvn/version "0.2.2"}}
   :ns-default build}}}
