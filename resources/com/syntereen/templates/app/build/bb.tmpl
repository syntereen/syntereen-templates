{:tasks
 {:requires ([babashka.fs :as fs])
  outdated {:doc "Find out what libs need updating but don't make changes."
            :task (clojure "-Tantq outdated")}
  updatelibs {:doc "Update all libs to latest."
              :task (clojure "-Tantq outdated --update")}
  lint {:doc "Lint all sources."
        :task (shell "clj-kondo --lint src:test")}
  clean {:doc "Removes all unneeded files."
         :task (do
                 (run! fs/delete-tree ["target"])
                 (run! fs/delete (fs/glob "." "**~")))}
  init {:doc "Initialize this dir with git."
        :task (do
                (shell "git init .")
                (shell "git add .")
                (shell "git commit -m \"Just after deps-new\""))}
  ;; The tasks below just delegate to build.clj
  test {:doc "Run all tests."
        :task (clojure "-T:build test")}
  tag {:doc "Tag the current commit with the current version."
       :task (clojure "-T:build tag")}
  ci {:doc "Create an uberjar file."
      :depends [clean]
      :task (clojure "-T:build ci")}
  }
 }
