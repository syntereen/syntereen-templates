;;; -*- clojure -*-
(ns build
  (:refer-clojure :exclude [test])
  (:require [clojure.tools.build.api :as b]
            [deps-deploy.deps-deploy :as dd]))

(def lib '{{group/id}}/{{artifact/id}})
(def major-version 0)
(def minor-version 1)
(def version (format "%d.%d.%s" major-version minor-version (b/git-count-revs nil)))
(def main '{{top/ns}}.{{main/ns}})
(def class-dir "target/classes")

;;; TODO: This is in two places - here and config.clj.
;;; TODO: Make it one place, if possible.
(def version-file "resources/{{top/file}}/{{main/file}}/version.edn")

(defn test "Run all the tests." [opts]
  (let [basis    (b/create-basis {:aliases [:test]})
        cmds     (b/java-command
                  {:basis      basis
                    :main      'clojure.main
                    :main-args ["-m" "cognitect.test-runner"]})
        {:keys [exit]} (b/process cmds)]
    (when-not (zero? exit) (throw (ex-info "Tests failed" {}))))
  opts)

(defn- uber-opts [opts]
  (assoc opts
          :version version
          :lib lib :main main
          :uber-file (format "target/%s-%s.jar" lib version)
          :scm {:tag (str "v" version)}
          :basis (b/create-basis {})
          :class-dir class-dir
          :target "target"
          :src-dirs ["src"]
          :ns-compile [main]))

(defn tag "Tag current commit with current version." [opts]
  (-> opts
      (assoc :command-args ["git" "tag" "-a" "-m" (str "Version: " version) (str "v" version)])
      (b/process))
  opts)

(defn ci "Run the CI pipeline of tests (and build the uberjar)." [opts]
  (test opts)
  (b/delete {:path "target"})
  (let [opts (uber-opts opts)]
    (println "\nWriting version.edn...")
    (b/write-file {:path version-file :content {:version-string version}})
    (println "\nWriting pom.xml...")
    (b/write-pom opts)
    (println "\nCopying source...")
    (b/copy-dir {:src-dirs ["resources" "src"] :target-dir class-dir})
    (println (str "\nCompiling " main "..."))
    (b/compile-clj opts)
    (println "\nBuilding JAR...")
    (b/uber opts))
  opts)
